@model IReadOnlyList<JobPreview>
@{ ViewData["Title"] = "Dashboard preview"; }
<section class="page-heading"><p class="eyebrow">Team workspace / Design preview</p><h1>Keep the next job in view.</h1><p class="lead">An early look at how staff will review requests and manage paving work.</p></section>
<p class="notice"><strong>Fictional sample data.</strong> This public preview is read-only. Staff sign-in and access controls are planned for a later milestone.</p>
<div class="stats-grid"><article class="stat"><span>Total requests</span><strong>@Model.Count</strong></article><article class="stat"><span>Awaiting review</span><strong>@Model.Count(job => job.Status == "New")</strong></article><article class="stat"><span>Scheduled</span><strong>@Model.Count(job => job.Status == "Scheduled")</strong></article><article class="stat"><span>Completed</span><strong>@Model.Count(job => job.Status == "Completed")</strong></article></div>
<section class="panel section"><div class="section-heading"><h2>Recent requests</h2><span class="tag">Sample records</span></div><div class="table-scroll"><table><caption class="sr-only">Fictional service requests in the dashboard preview</caption><thead><tr><th scope="col">Request</th><th scope="col">Customer</th><th scope="col">Service</th><th scope="col">Status</th><th scope="col">Assigned to</th></tr></thead><tbody>@foreach (var job in Model) { <tr><td>#@job.RequestNumber</td><td>@job.Customer</td><td>@job.Service</td><td><span class="status">@job.Status</span></td><td>@job.AssignedEmployee</td></tr> }</tbody></table></div></section>
<section class="panel weather-panel"><div><p class="eyebrow">Planned integration</p><h2>Weather at the job site</h2><p>Temperature and precipitation forecasts will support scheduling decisions.</p></div><span class="tag">API not connected yet</span></section>
